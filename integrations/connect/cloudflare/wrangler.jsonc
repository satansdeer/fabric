{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fabric-connect",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  // Provision principal hashes/scopes privately. Keep the three existing bootstrap bindings
  // until the deployed v1 inbox has migrated; its credential is then durably route-scoped.
  // No GitHub token is hosted.
  "secrets": {
    "required": ["FABRIC_CONNECT_PRINCIPALS"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CONNECT_INBOX", "class_name": "ConnectInbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConnectInbox"] }]
}
